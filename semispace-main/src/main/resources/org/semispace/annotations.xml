    </item>
    <item name="org.semispace.SemiSpaceInterface org.semispace.SemiEventRegistration notify(java.lang.Object, org.semispace.SemiEventListener, long) 0">
        <annotation name="org.jetbrains.annotations.NotNull"/>
    </item>
